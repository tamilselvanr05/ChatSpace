# Vite reads frontend variables from the repository root in this project.
# Frontend variables are public configuration; never put credentials here.
VITE_API_URL=<your-backend-url>

# Backend CORS allowlist. Multiple frontend origins may be comma-separated.
CLIENT_URL=<your-frontend-origin>

# Backend runtime configuration.
PORT=3030
MONGO_URI=<your-mongodb-connection-string>
# Optional. Defaults to server/uploads; production should use persistent storage.
UPLOAD_DIR=<persistent-upload-directory>
# Optional outside local development; set to the mounted Firebase secret file path.
FIREBASE_SERVICE_ACCOUNT_PATH=<path-to-firebase-service-account.json>

# Backend-only key from a Gemini project that is not linked to billing (free tier only).
GEMINI_API_KEY=your_api_key_here
# Available free-tier text model; override only with a model that has free-tier access.
GEMINI_MODEL=gemini-3.5-flash-lite
